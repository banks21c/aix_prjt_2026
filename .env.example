# 이 파일을 .env로 복사한 뒤 실제 값을 채워넣으세요. (.env는 git에 커밋되지 않습니다)
SECRET_KEY=

# 로컬 개발 중에만 True로. 값을 비워두거나 생략하면 False(운영 안전 기본값)로 동작합니다.
DEBUG=True

DB_NAME=nextfinup_db
DB_USER=nextfinup_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 카카오: https://developers.kakao.com (내 애플리케이션 > 앱 키 > REST API 키)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 구글: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 네이버: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 챗봇용 OpenAI API 키. 비워두면 시뮬레이션 모드로 동작합니다.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# 한국투자증권(KIS) Open API: https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=

# 워드프레스/티스토리/네이버 블로그 자동 포스팅 계정은 더 이상 여기서 관리하지 않습니다.
# 회원 각자 /mypage/ 에서 본인 사이트/계정 정보를 등록합니다 (articles.models.BlogPostingAccount).

# Gmail SMTP (이메일 인증 발송용, https://myaccount.google.com/apppasswords 에서 발급한 앱 비밀번호)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
