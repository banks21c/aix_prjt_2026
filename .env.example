# 이 파일을 .env로 복사한 뒤 실제 값을 채워넣으세요. (.env는 git에 커밋되지 않습니다)
SECRET_KEY=

# 로컬 개발 중에만 True로. 값을 비워두거나 생략하면 False(운영 안전 기본값)로 동작합니다.
DEBUG=True

# BlogPostingAccount.credential(비밀번호/OAuth 리프레시 토큰) 암호화용 Fernet 키.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 로 생성.
# 분실 시 기존 저장된 credential을 복호화할 수 없게 되므로 안전하게 백업해둘 것.
CREDENTIAL_ENCRYPTION_KEY=

DB_NAME=nextfinup_db
DB_USER=nextfinup_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 카카오: https://developers.kakao.com (내 애플리케이션 > 앱 키 > REST API 키)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 구글: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 네이버: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 챗봇용 OpenAI API 키. 비워두면 시뮬레이션 모드로 동작합니다.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# 기사 AI 3줄 요약/투자 분석/블로그 초안 생성용 Gemini API 키 (Google AI Studio에서 무료 발급).
# 비워두면 시뮬레이션 모드로 동작합니다.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 한국투자증권(KIS) Open API: https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=

# 한국수출입은행 OpenAPI(환전 고시 환율): https://www.koreaexim.go.kr/ir/HPHKIR019M01
EXIM_AUTH_KEY=

# DART(전자공시시스템) Open API: https://opendart.fss.or.kr
DART_API_KEY=

# 워드프레스/티스토리/네이버 블로그 자동 포스팅 계정은 더 이상 여기서 관리하지 않습니다.
# 회원 각자 /mypage/ 에서 본인 사이트/계정 정보를 등록합니다 (articles.models.BlogPostingAccount).

# Gmail SMTP (이메일 인증 발송용, https://myaccount.google.com/apppasswords 에서 발급한 앱 비밀번호)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
